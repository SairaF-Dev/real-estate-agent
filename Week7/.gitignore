# Python bytecode, virtual environments, and build artifacts.
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/

# Test output and tool caches, including custom pytest base directories.
.pytest_cache/
.pytest_*/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage/

# Frontend dependencies and generated Next.js / TypeScript output.
node_modules/
.next/
*.tsbuildinfo

# Local editor and operating system files.
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local runtime data and logs.
.n8n-runtime/
.npm-cache/
.n8n-data/
day4/n8n/*.log

# Local environment files may contain API keys and credentials.
.env
.env.*
**/.env
**/.env.*

# Conversation learning records may contain sensitive customer context.
data/learning/*.jsonl
day7/vapi_integration/data/learning/*.jsonl

# Keep sanitized configuration templates in version control.
!.env.example
!**/.env.example
